# Neon Postgres connection string (Dashboard → Connection details)
# Never commit the real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&uselibpqcompat=true

# Optional: set to true to log SQL
# DB_LOGGING=false

PORT=3001

# Clerk — same app as the mobile Expo client.
# Get both from Clerk Dashboard → API Keys.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible image storage)
# Create: Cloudflare Dashboard → R2 → bucket + API token (Object Read & Write)
# Leave blank until you have keys — uploads return 503; app uses logo fallback.
# Never put these in the Expo app.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jevan-hana-dev
# Public URL prefix for objects (R2.dev subdomain or custom domain). No trailing slash.
# Example: https://pub-xxxxx.r2.dev  OR  https://media.yourdomain.com
R2_PUBLIC_BASE_URL=
